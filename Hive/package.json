{
  "name": "@hiveory/hive",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:deps && tsc && vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:deps": "pnpm -r --filter \"@hiveory/*\" --filter \"!@hiveory/hive\" build"
  },
  "dependencies": {
    "@hiveory/bee-voice": "workspace:*",
    "@hiveory/hiveextension": "workspace:*",
    "@hiveory/hivemind": "workspace:*",
    "@hiveory/honeyboard": "workspace:*",
    "@hiveory/nectar": "workspace:*",
    "@hiveory/nectar-mcp": "workspace:*",
    "@hiveory/plugins": "workspace:*",
    "@hiveory/queenbee": "workspace:*",
    "@hiveory/taskcomb": "workspace:*",
    "@hiveory/worker-bees": "workspace:*",
    "@hiveory/workhive": "workspace:*",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.0",
    "@hiveory/honeyflow": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.3.1",
    "vitest": "^2.1.0"
  }
}
